+                            (multiplier * sizeof(value_type))));
+            size *= multiplier;
+            FAISS_THROW_IF_NOT_FMT(
+                    size <= SIZE_MAX / sizeof(value_type),
+                    "read_vector_base: size %zu would overflow for element size %zu",
+                    size,
