+            std::shared_ptr<MaybeOwnedVectorOwner> owner;
+            void* address = f->allocate_for_read(size * sizeof(value_type), &owner);
+            if (address != nullptr) {
+                // Read straight into the supplied block. If this throws, `owner` goes
+                // out of scope here and the block is released with it.
+                auto* typed = reinterpret_cast<value_type*>(address);
+                READANDCHECK(typed, size);
+                // Ownership moves into the vector only once the bytes are all there.
+                target = VectorT::create_view(address, size, owner);
+                return true;
+            }
+
+            // Declined. The size is already gone from the stream, so finish the read
+            // here rather than handing it back to READVECTOR.
+            target.resize(size);
+            READANDCHECK(target.data(), size);
